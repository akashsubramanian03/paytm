# ---------------------------------------------------------------------------
# Paytm backend configuration
# Copy this file to `.env` and fill in the values. Nothing is hardcoded in src/.
# ---------------------------------------------------------------------------

# Local SQLite database file. Relative paths are resolved from ./prisma/
DATABASE_URL="file:./paytm.db"

# REQUIRED. Signing secret for auth tokens. The server refuses to boot without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# How long an issued session stays valid.
JWT_EXPIRES_IN="7d"

# API server
PORT=4000
HOST="127.0.0.1"

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Demo money credited to a brand new wallet, in paise. 1000000 = Rs 10,000.00
SIGNUP_BONUS_PAISE=1000000

# Cost factor for password hashing.
BCRYPT_ROUNDS=10

# Largest single transfer allowed, in paise. 20000000 = Rs 2,00,000.00
MAX_TRANSFER_PAISE=20000000

# "development" enables request logging and verbose errors.
NODE_ENV="development"

# ---------------------------------------------------------------- Nambikai --
# Nambikai is the trust / alternative-credit layer on top of the wallet.
# All of these are optional — the app boots and the demo works without any of them.

# Optional. When set, the AI layer writes the prose on five surfaces: the
# underwriting recommendation, the personal assistant, the SME assistant, the
# borrowing decline and the income-proof summary. When empty, all five fall back
# to deterministic templates and the demo is otherwise identical. The model never
# produces a score, a band or a rupee figure either way.
OPENAI_API_KEY=""

NAMBIKAI_AI_MODEL=gpt-4o

# Optional. Point at an OpenAI-compatible endpoint (Azure OpenAI, a gateway)
# instead of api.openai.com. Leave empty for the normal case.
# NAMBIKAI_AI_BASE_URL=
NAMBIKAI_AI_MAX_TOKENS=500
NAMBIKAI_AI_TIMEOUT_MS=20000

# Spend controls. Exceeding either budget returns the deterministic template
# rather than an error, so the product keeps working after the bill stops.
# Set a budget to 0 to disable the model without removing the key.
NAMBIKAI_AI_DAILY_CALL_BUDGET=150
NAMBIKAI_AI_USER_CALL_BUDGET=25

# Model prose is cached on the same inputs hash the score is derived from, so
# reopening a screen on the same day costs nothing.
NAMBIKAI_AI_CACHE_SIZE=500

# Bumping the engine version invalidates every cached score.
NAMBIKAI_ENGINE_VERSION=nbk-1.0.0

# How long a computed financial health score stays fresh before recompute.
NAMBIKAI_SCORE_TTL_MINUTES=360
