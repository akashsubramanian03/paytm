# ---------------------------------------------------------------------------
# Paytm backend configuration
# Copy this file to `.env` and fill in the values. Nothing is hardcoded in src/.
# ---------------------------------------------------------------------------

# Local SQLite database file. Relative paths are resolved from ./prisma/
DATABASE_URL="file:./paytm.db"

# REQUIRED. Signing secret for auth tokens. The server refuses to boot without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# How long an issued session stays valid.
JWT_EXPIRES_IN="7d"

# API server
PORT=4000
HOST="127.0.0.1"

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Demo money credited to a brand new wallet, in paise. 1000000 = Rs 10,000.00
SIGNUP_BONUS_PAISE=1000000

# Cost factor for password hashing.
BCRYPT_ROUNDS=10

# Largest single transfer allowed, in paise. 20000000 = Rs 2,00,000.00
MAX_TRANSFER_PAISE=20000000

# "development" enables request logging and verbose errors.
NODE_ENV="development"
