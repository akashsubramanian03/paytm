{
  "name": "paytm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-only Paytm-style wallet API. All money is simulated in a local SQLite database.",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "NODE_ENV=test DATABASE_URL=\"file:./test.db\" node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.3.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
