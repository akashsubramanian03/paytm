# ---------------------------------------------------------------------------
# Paytm frontend configuration
# Copy this file to `.env`. Vite only exposes variables prefixed with VITE_.
# ---------------------------------------------------------------------------

# Base URL of the local backend API.
VITE_API_BASE_URL="http://127.0.0.1:4000/api/v1"

# Port the dev server listens on. Must be in the backend's CORS_ORIGIN list.
VITE_PORT=5173

# Shown in the UI so nobody mistakes this for a real payments app.
VITE_APP_NAME="Paytm"
